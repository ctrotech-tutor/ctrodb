{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "ctrodb": [
        "../../dist/index.d.ts"
      ],
      "ctrodb/react": [
        "../../dist/react/react.d.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "index.ts",
    "docs.tsx"
  ]
}
